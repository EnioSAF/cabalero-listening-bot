{
  "name": "cabalero-listening-bot",
  "version": "1.0.0",
  "description": "Bot Discord pour les sessions d'écoute du lundi de Cabalero : anti-doublon, anti-flood/spam, backup et clear de salon.",
  "type": "module",
  "license": "MIT",
  "author": "EnioSAF",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EnioSAF/cabalero-listening-bot.git"
  },
  "bugs": {
    "url": "https://github.com/EnioSAF/cabalero-listening-bot/issues"
  },
  "homepage": "https://github.com/EnioSAF/cabalero-listening-bot#readme",
  "keywords": [
    "discord",
    "discord.js",
    "bot",
    "anti-spam",
    "anti-duplicate",
    "moderation",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "tsx --test src/**/*.test.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "deploy": "tsx src/deploy-commands.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "cron-parser": "^4.9.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "node-cron": "^3.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
