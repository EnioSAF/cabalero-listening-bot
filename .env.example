# --- Discord ---
# Token du bot (Dev Portal > Bot > Reset Token)
DISCORD_TOKEN=colle_ton_token_ici
# ID de l'application (Dev Portal > General Information > Application ID)
DISCORD_CLIENT_ID=colle_ton_client_id_ici
# (Optionnel) ID du serveur Cabalero : si renseigné, les commandes slash sont
# déployées uniquement sur ce serveur (mise à jour instantanée au lieu de ~1h).
DISCORD_GUILD_ID=

# --- Stockage ---
# Chemin du fichier SQLite (créé automatiquement)
DATABASE_PATH=./data/bot.db

# --- Divers ---
# Fuseau horaire par défaut pour les sessions auto du lundi
DEFAULT_TIMEZONE=Europe/Paris
